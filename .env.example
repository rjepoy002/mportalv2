PALECO_SOA_API_KEY=replace-with-server-side-soa-key
# Optional: comma-separated HTTPS PDF hosts returned by the SOA service.
PALECO_SOA_PDF_HOSTS=soa.paleco.net

# New account linking is disabled until PALECO approves historical SOA amounts.
# Apply migrations/20261016_account_link_verification.sql before activation.
PALECO_LINK_BILLING_ENABLED=0
# Record an approval ticket/document reference in the actual server environment.
PALECO_LINK_POLICY_APPROVAL=
# Optional local testing only: also requires APP_ENV/MCO_APP_ENV=development
# and real loopback SERVER_ADDR and REMOTE_ADDR. Never grants production approval.
PALECO_LINK_LOCAL_TESTING=0

# Configure this in the PHP process environment (for example Apache SetEnv).
# This file is documentation only; the application does not load .env files.
APP_URL=http://localhost/mportalv2
# Set APP_ENV=production on deployed servers; APP_URL is then mandatory and HTTPS-only.
APP_ENV=development
# Production example (HTTPS required outside localhost/loopback):
# APP_URL=https://your-production-domain.com

# Shared by every PHP worker, outside the web root, writable only by the service account.
# Default: PHP temporary directory / mco-portal-reset-limits (single-server deployments).
# PASSWORD_RESET_RATE_DIR=C:/xampp/private/mco-reset-limits

# Set these in the actual PHP/Apache environment. No dotenv loader is installed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-smtp-account@example.com
SMTP_PASSWORD=replace-with-smtp-secret
SMTP_FROM_EMAIL=your-smtp-account@example.com
# Enable workflow milestone logs temporarily; operational failures always log.
PASSWORD_RESET_DEBUG=0

# Consumer Education: enable YouTube Data API v3 and set a server-restricted key.
# Environment variables must be supplied to PHP/Apache; .env is not auto-loaded.
YOUTUBE_API_KEY=
# Six-hour cache, outside the web root and writable by the PHP service account.
# YOUTUBE_PLAYLIST_CACHE_DIR=C:/xampp/private/mportal-education
